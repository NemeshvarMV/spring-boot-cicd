# ==============================================================================
# DATABASE CONFIGURATION (MySQL) - EXAMPLE TEMPLATE
# Copy this file to .env and replace with your real values.
# ==============================================================================
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_DATABASE=studentdb
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

SPRING_DATASOURCE_URL=jdbc:mysql://mysqldb:3306/studentdb?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password

# ==============================================================================
# APPLICATION & DEPLOYMENT CONFIGURATION
# ==============================================================================
# Port 8081 prevents port conflicts with Jenkins (which runs on port 8080)
APP_PORT=8081

# AWS & Registry Coordinates
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
REPO_NAME=spring-boot-app
ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
IMAGE_NAME=123456789012.dkr.ecr.us-east-1.amazonaws.com/spring-boot-app
IMAGE_TAG=latest

# EC2 Target Host
EC2_HOST=ubuntu@<EC2_PUBLIC_IP>
EC2_IP=<EC2_PUBLIC_IP>

# Jenkins Credentials IDs (configured in Jenkins Dashboard)
AWS_CRED_ID=aws-credentials
EC2_SSH_CRED=ec2-ssh-key
